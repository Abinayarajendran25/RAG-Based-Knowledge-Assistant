#- Today, Module 2 – Document Upload and Processing Module
# Description: 
- This module allows users to upload documents such as PDF, DOCX, and TXT files. The uploaded documents are processed, cleaned, and prepared for storage in the knowledge base to support accurate information retrieval.
from langchain_community.document_loaders import PyPDFLoader
from langchain.text_splitter import RecursiveCharacterTextSplitter


def process_document(file):

    loader = PyPDFLoader(file)

    documents = loader.load()

    splitter = RecursiveCharacterTextSplitter(
        chunk_size=500,
        chunk_overlap=50
    )

    chunks = splitter.split_documents(documents)
    return chunks
